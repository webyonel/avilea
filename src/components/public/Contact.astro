---
// src/components/public/Contact.astro
import { LOCATIONS, SCHEDULE_LABEL } from '../../lib/contact';
import { waLink } from '../../lib/whatsapp';

// Cada card apunta al WhatsApp de su propio local.
// El mensaje es genérico porque el cliente aún no elige qué producto ver en el local.
const locationLinks = LOCATIONS.map((loc) => ({
  ...loc,
  href: waLink(loc.phone, 'Hola Avilea, me gustaría más información sobre el local de ' + loc.name),
}));
---

<section class="section section-dark" id="contacto">
  <div class="container">
    <div class="section-head section-head-light">
      <span class="eyebrow eyebrow-light">Visítanos o escríbenos</span>
      <h2 class="section-title light">Tu próxima armadura <em>te espera</em>.</h2>
      <p class="section-sub section-sub-light">Tres locales en Ciego de Ávila, Pina y Morón. Escríbenos al WhatsApp del que te quede más cerca y te asesoramos sin compromiso.</p>
    </div>

    <div class="locations-grid">
      {locationLinks.map((loc) => (
        <article class="location-card">
          <div class="location-image">
            <img src={loc.image} alt={`Local Avilea en ${loc.name}`} loading="lazy" />
          </div>
          <div class="location-body">
            <span class="location-tag">Avilea · {loc.name}</span>
            {loc.address && <p class="location-address">{loc.address}</p>}
            <a href={loc.href} class="btn btn-wa location-cta" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              {loc.display}
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="schedule-strip">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>{SCHEDULE_LABEL}</span>
    </div>
  </div>
</section>
