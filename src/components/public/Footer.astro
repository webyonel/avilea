---
// src/components/public/Footer.astro
import { defaultWaLink, WA_PHONE } from '../../lib/whatsapp';

const waHref = defaultWaLink('Hola Avilea, me gustaría más información');

// Para que las anclas funcionen tanto en la home como desde /sobre-nosotros.
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const baseClean = base.replace(/\/$/, '');
const isHome = currentPath === baseClean;
const homePrefix = isHome ? '' : base;
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/#inicio`} class="logo">
        <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logo.webp`} alt="Avilea Óptica" class="logo-img" width="180" height="180" />
      </a>
      <p>Comercializadora de productos ópticos en Ciego de Ávila. Espejuelos y lentes de contacto con calidad certificada.</p>
    </div>

    <div class="footer-cols">
      <div class="footer-col">
        <h5>Navegación</h5>
        <a href={`${homePrefix}#inicio`}>Inicio</a>
        <a href={`${homePrefix}#productos`}>Productos</a>
      </div>
      <div class="footer-col">
        <h5>Contacto</h5>
        <a href={waHref} target="_blank" rel="noopener">WhatsApp</a>
        <span>Joaquín de Aguero esq. Maceo</span>
        <span>En el Cine Iriondo</span>
        <span>Ciego de Ávila, Cuba</span>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© 2026 Avilea · Óptica y Visión</span>
  </div>
</footer>
