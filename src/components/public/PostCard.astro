---
// src/components/public/PostCard.astro
// Card de un post del blog. Click abre el modal fullscreen (PostModal),
// ya no navega a /blog/:slug porque esa ruta no existe en esta scope.
// El handler serializa el post completo (incluyendo `contentHtml` que
// pre-renderiza el servidor) y dispara el evento `post:open`.
import type { Post } from '../../lib/posts';
import { POST_CATEGORY_LABEL, formatPostDate } from '../../lib/posts';

interface Props {
  post: Post & { contentHtml?: string };
}

const { post } = Astro.props;
const dateLabel = formatPostDate(post.date);
const categoryLabel = POST_CATEGORY_LABEL[post.category];

// Payload que se pasa al modal al abrir. Incluímos todo lo que PostModal
// necesita para renderizar (title, contentHtml, cover, etc.).
const payload = {
  title: post.title,
  contentHtml: post.contentHtml ?? '',
  cover: post.cover,
  coverAlt: post.title,
  categoryLabel,
  dateLabel,
  author: post.author,
};
---

<article class="post-card" data-reveal>
  <button
    type="button"
    class="post-card__link"
    data-post-card
    data-post={JSON.stringify(payload)}
    aria-label={`Leer: ${post.title}`}
  >
    <div class="post-card__media">
      <img src={post.cover} alt={post.title} loading="lazy" class="post-card__img" />
      <span class="post-card__chip">{categoryLabel}</span>
    </div>
    <div class="post-card__body">
      <p class="post-card__meta">
        <time datetime={post.date}>{dateLabel}</time>
        {post.author && <><span aria-hidden="true">·</span><span>{post.author}</span></>}
      </p>
      <h3 class="post-card__title">{post.title}</h3>
      <p class="post-card__excerpt">{post.excerpt}</p>
      <span class="post-card__cta">
        Leer artículo
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </span>
    </div>
  </button>
</article>

<!-- Los estilos de .post-card* viven en src/styles/styles.css (BLOG CARDS)
     porque las cards se hidratan en el browser via innerHTML y los estilos
     scoped de Astro no alcanzarían a esos elementos. -->
