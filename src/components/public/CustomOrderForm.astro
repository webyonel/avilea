---
// src/components/public/CustomOrderForm.astro
// Formulario de espejuelos a medida. Fase 1: solo abre WhatsApp,
// no persiste. El número de destino es WA_PHONE_ORDERS (no WA_PHONE).
//
// Fase 2 → runtime: el catálogo se hidrata en el browser con sharedFetchProducts
// (ver <script> al final de este archivo). El frontmatter ya no deriva las
// listas de productos — las inyectan los scripts al cargar la página.
import { WA_PHONE_ORDERS } from '../../lib/whatsapp';
import {
  EMPTY_ORDER,
  MATERIALS,
  TREATMENTS,
  FOCAL_DISTANCES,
  PROGRESIVO_INDICES,
  orderToMessage,
} from '../../lib/orders';
import type { Product } from '../../lib/catalog';

interface Props {
  /** Deprecated: el catálogo se hidrata en runtime vía sharedFetchProducts.
   *  Se conserva la prop para no romper consumidores externos (ej. tests)
   *  pero se ignora. */
  products?: Product[];
}
const {} = Astro.props;
---

<section class="section section-alt" id="pedido">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Espejuelos a medida</span>
      <h2 class="section-title">Manda a hacer tus <em>espejuelos</em></h2>
      <p class="section-sub">Completa tu receta y te contactamos por WhatsApp para confirmar disponibilidad y plazo.</p>
    </div>

    <aside class="tryon-callout">
      <div class="tryon-callout__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="7.5" cy="13.5" r="3.5"/>
          <circle cx="16.5" cy="13.5" r="3.5"/>
          <line x1="11" y1="13.5" x2="13" y2="13.5"/>
          <path d="M2.5 7.5 L2.5 18.5 a2 2 0 0 0 2 2 L19.5 20.5 a2 2 0 0 0 2 -2 L21.5 8.5 a2 2 0 0 0 -2 -2 L17 6.5 L15 4.5 L9 4.5 L7 6.5 L4.5 6.5 a2 2 0 0 0 -2 2 z"/>
        </svg>
      </div>
      <div class="tryon-callout__body">
        <p class="tryon-callout__title">¿Querés ver cómo te quedan antes de pedirlas?</p>
        <p class="tryon-callout__text">Probá nuestras armaduras con tu propia foto, ahora mismo, desde el celular.</p>
      </div>
      <button type="button" class="btn btn-primary tryon-callout__btn" data-tryon-open>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
          <circle cx="12" cy="13" r="4"/>
        </svg>
        Probar armaduras
      </button>
    </aside>

    <form class="order-form" id="orderForm" novalidate>
      <div class="form-row">
        <label class="form-field">
          <span class="form-label">Nombre y Apellidos <em>*</em></span>
          <input type="text" name="fullName" required autocomplete="name" />
        </label>
        <label class="form-field">
          <span class="form-label">Carnet de Identidad <em>*</em></span>
          <input type="text" name="ci" required inputmode="numeric" />
        </label>
      </div>

      <fieldset class="choices-block armadura-block">
        <legend>Armadura</legend>

        <div class="armadura-card" data-armadura-card hidden>
          <div class="armadura-card__thumb" data-armadura-thumb aria-hidden="true"></div>
          <div class="armadura-card__info">
            <p class="armadura-card__name" data-armadura-name></p>
            <p class="armadura-card__price" data-armadura-price></p>
          </div>
          <button type="button" class="armadura-card__clear" data-armadura-clear aria-label="Quitar selección del probador">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
            Quitar
          </button>
        </div>

        <p class="armadura-hint" data-armadura-hint>
          Sin selección. Elegí una armadura del catálogo de abajo o probá las armaduras arriba con el probador virtual.
        </p>

        <div class="armadura-custom-select" data-armadura-select-wrap>
          <button
            type="button"
            class="armadura-custom-select__trigger"
            data-armadura-select-trigger
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <span class="armadura-custom-select__thumb" data-armadura-select-thumb aria-hidden="true"></span>
            <span class="armadura-custom-select__info">
              <span class="armadura-custom-select__name" data-armadura-select-name>
                Elegí una armadura del catálogo
              </span>
              <span class="armadura-custom-select__price" data-armadura-select-price>
                o usá el probador arriba
              </span>
            </span>
            <span class="armadura-custom-select__chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </span>
          </button>

          <ul
            class="armadura-custom-select__menu"
            role="listbox"
            data-armadura-select-menu
            aria-label="Armaduras del catálogo"
            data-armadura-options
            hidden
          >
            {/* El script del final inyecta las opciones runtime con sharedFetchProducts. */}
          </ul>
        </div>

        <input type="hidden" name="armaduraId" data-armadura-id value="" />
        <input type="hidden" name="armaduraNombre" data-armadura-manual-name value="" />
        <input type="hidden" name="armaduraPrecio" data-armadura-manual-price value="" />
      </fieldset>

      <fieldset class="choices-block">
        <legend>Material del cristal</legend>
        <div class="choices-row" role="radiogroup" aria-label="Material del cristal">
          {MATERIALS.map((m) => (
            <div class="choice-item">
              <label class:list={["choice", m.disabled && "choice--disabled"]}>
                <input type="radio" name="material" value={m.value} disabled={m.disabled} />
                <span>{m.label}</span>
                <button type="button" class="info-btn" aria-label={`Qué es ${m.label}`} data-info-trigger>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                </button>
              </label>
              <div class="choice-info" role="tooltip" hidden>
                <p>{m.description}</p>
              </div>
            </div>
          ))}
        </div>
      </fieldset>

      <fieldset class="choices-block">
        <legend>Tratamientos <span class="form-hint-inline">(podés elegir varios)</span></legend>
        <div class="choices-row">
          {TREATMENTS.map((t) => (
            <div class="choice-item">
              <label class:list={["choice", t.disabled && "choice--disabled"]}>
                <input type="checkbox" name="tratamiento" value={t.value} disabled={t.disabled} />
                <span>{t.label}</span>
                <button type="button" class="info-btn" aria-label={`Qué es ${t.label}`} data-info-trigger>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                </button>
              </label>
              <div class="choice-info" role="tooltip" hidden>
                <p>{t.description}</p>
              </div>
            </div>
          ))}
        </div>
      </fieldset>

      <fieldset class="choices-block">
        <legend>Distancias focales <span class="form-hint-inline">(podés elegir varias)</span></legend>
        <div class="choices-row">
          {FOCAL_DISTANCES.map((f) => (
            <div class="choice-item">
              <label class="choice">
                <input type="checkbox" name="focal" value={f.value} />
                <span>{f.label}</span>
                <button type="button" class="info-btn" aria-label={`Qué es ${f.label}`} data-info-trigger>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                </button>
              </label>
              <div class="choice-info" role="tooltip" hidden>
                <p>{f.description}</p>
              </div>
            </div>
          ))}
        </div>
      </fieldset>

      <fieldset class="choices-block progresivo-index-block" data-progresivo-wrap hidden>
        <legend>Índice del progresivo <span class="form-hint-inline">(qué tan delgado es el lente)</span></legend>
        <div class="choices-row">
          {PROGRESIVO_INDICES.map((i) => (
            <div class="choice-item">
              <label class="choice">
                <input type="radio" name="progresivoIndex" value={i.value} />
                <span>{i.label}</span>
                <button type="button" class="info-btn" aria-label={`Qué es ${i.label}`} data-info-trigger>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                </button>
              </label>
              <div class="choice-info" role="tooltip" hidden>
                <p>{i.description}</p>
              </div>
            </div>
          ))}
        </div>
      </fieldset>

      <div class="eyes-grid">
        <fieldset class="eye-block">
          <legend>Ojo derecho (OD)</legend>
          <div class="form-row">
            <label class="form-field">
              <span class="form-label">Esfera</span>
              <input type="text" name="od.esfera" placeholder="ej. -1.50" />
            </label>
            <label class="form-field">
              <span class="form-label">Cilindro</span>
              <input type="text" name="od.cilindro" placeholder="ej. -0.50" />
            </label>
          </div>
          <div class="form-row">
            <label class="form-field">
              <span class="form-label">Eje (°)</span>
              <input type="number" name="od.eje" min="0" max="180" step="1" />
            </label>
            <label class="form-field">
              <span class="form-label">Prisma</span>
              <input type="text" name="od.prisma" />
            </label>
          </div>
          <label class="form-field">
            <span class="form-label">Base</span>
            <input type="text" name="od.base" placeholder="sup / inf / int / ext" />
          </label>
        </fieldset>

        <fieldset class="eye-block">
          <legend>Ojo izquierdo (OI)</legend>
          <div class="form-row">
            <label class="form-field">
              <span class="form-label">Esfera</span>
              <input type="text" name="oi.esfera" placeholder="ej. -1.50" />
            </label>
            <label class="form-field">
              <span class="form-label">Cilindro</span>
              <input type="text" name="oi.cilindro" placeholder="ej. -0.50" />
            </label>
          </div>
          <div class="form-row">
            <label class="form-field">
              <span class="form-label">Eje (°)</span>
              <input type="number" name="oi.eje" min="0" max="180" step="1" />
            </label>
            <label class="form-field">
              <span class="form-label">Prisma</span>
              <input type="text" name="oi.prisma" />
            </label>
          </div>
          <label class="form-field">
            <span class="form-label">Base</span>
            <input type="text" name="oi.base" placeholder="sup / inf / int / ext" />
          </label>
        </fieldset>
      </div>

      <div class="form-row form-row-3">
        <label class="form-field">
          <span class="form-label">Adición</span>
          <input type="text" name="adicion" placeholder="ej. +1.50" />
        </label>
        <label class="form-field">
          <span class="form-label">Distancia pupilar (mm)</span>
          <input type="text" name="distanciaPupilar" placeholder="ej. 62" />
        </label>
        <label class="form-field">
          <span class="form-label">Eje de astigmatismo (°)</span>
          <input type="number" name="ejeAstigmatismo" min="0" max="180" step="1" />
        </label>
      </div>

      <p class="order-hint">
        Los campos marcados con <em>*</em> son obligatorios. El resto puedes dejarlo en blanco si tu receta no los incluye.
      </p>

      <aside class="order-pricing" data-order-pricing>
        <div class="order-pricing__head">
          <h4 class="order-pricing__title">Precio estimado</h4>
          <p class="order-pricing__sub" data-pricing-sub>Elegí material y distancia focal para ver el precio.</p>
        </div>
        <div class="order-pricing__body" data-pricing-body></div>
        <p class="order-pricing__rate-note" data-pricing-rate-note hidden></p>
      </aside>

      <button type="submit" class="btn btn-wa btn-lg order-submit">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        Enviar por WhatsApp
      </button>

      <p class="order-confirmation" id="orderConfirmation" hidden>
        Te redirigimos a WhatsApp para confirmar el pedido.
      </p>
    </form>
  </div>

  <!-- Probador virtual: modal fullscreen. HTML + CSS + abrir/cerrar + file→preview + swap de armadura. -->
  <div class="tryon-modal" id="tryonModal" hidden role="dialog" aria-modal="true" aria-labelledby="tryonTitle">
    <div class="tryon-modal__backdrop" data-tryon-close aria-hidden="true"></div>

    <div class="tryon-modal__panel" role="document">
      <header class="tryon-header">
        <div class="tryon-header__text">
          <span class="tryon-eyebrow">Probador virtual</span>
          <h3 id="tryonTitle" class="tryon-title">Probá nuestras armaduras</h3>
        </div>
        <button type="button" class="tryon-close" aria-label="Cerrar" data-tryon-close>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="22" height="22">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </header>

      <div class="tryon-body">
        <!-- Estado 1: vacío / pedir foto -->
        <div class="tryon-stage" data-stage="empty">
          <div class="tryon-upload">
            <div class="tryon-upload__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
            </div>
            <h4 class="tryon-upload__title">Subí tu foto</h4>
            <p class="tryon-upload__hint">
              Una foto clara, mirando al frente y con buena luz. La foto no se guarda: solo se usa en este momento para mostrarte las armaduras sobre tu rostro.
            </p>
            <div class="tryon-upload__actions">
              <label class="btn btn-primary btn-lg tryon-upload__btn" data-tryon-file-label>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="20" height="20">
                  <rect x="3" y="5" width="18" height="14" rx="2"/>
                  <circle cx="8.5" cy="10.5" r="1.5"/>
                  <path d="M21 17l-5-5-9 9"/>
                </svg>
                Elegir foto
                <input type="file" accept="image/*" class="tryon-file" data-tryon-file hidden />
              </label>
              <button type="button" class="btn btn-ghost btn-lg tryon-upload__btn-secondary" data-tryon-camera>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="20" height="20">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                  <circle cx="12" cy="13" r="4"/>
                </svg>
                Tomar foto ahora
              </button>
            </div>
          </div>
        </div>

        <!-- Estado 2: con foto + armaduras -->
        <div class="tryon-stage" data-stage="preview" hidden>
          <div class="tryon-canvas">
            <img class="tryon-photo" alt="Tu foto" />
            <div class="tryon-frame-overlay" aria-hidden="true" data-frame-overlay title="Arrastrá para mover · Scroll o pinch para zoom · Shift+arrastrar para rotar"></div>
            <div class="tryon-hint" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
              </svg>
              Mirá al frente y mantené la cabeza derecha para una mejor vista.
            </div>
            <button type="button" class="btn btn-ghost tryon-replace" data-tryon-replace>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16">
                <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
              </svg>
              Cambiar foto
            </button>
            <button type="button" class="btn btn-ghost tryon-reset" data-tryon-reset aria-label="Centrar armadura">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16">
                <circle cx="12" cy="12" r="3"/>
                <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/>
              </svg>
              Centrar armadura
            </button>
          </div>

          <div class="tryon-rail-wrap">
            <p class="tryon-rail__label">Armaduras disponibles</p>
            <div class="tryon-rail">
              <button type="button" class="tryon-rail__nav tryon-rail__nav--prev" aria-label="Anterior" data-tryon-rail-prev>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="22" height="22">
                  <polyline points="15 18 9 12 15 6"/>
                </svg>
              </button>
              <ul class="tryon-rail__list" role="radiogroup" aria-label="Elegí una armadura" data-tryon-rail>
                {/* El script del final inyecta las armaduras runtime con sharedFetchProducts. */}
              </ul>
              <button type="button" class="tryon-rail__nav tryon-rail__nav--next" aria-label="Siguiente" data-tryon-rail-next>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="22" height="22">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <footer class="tryon-footer">
        <p class="tryon-footer__text">
          Probá todas las armaduras sin compromiso. Cuando encuentres la tuya,
          <button type="button" class="tryon-footer__link" data-tryon-jump>completá el pedido</button>.
        </p>
      </footer>
    </div>
  </div>
</section>

<style>
  .order-form {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 32px;
    box-shadow: var(--shadow-md);
    max-width: 880px;
    margin: 0 auto;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 20px;
  }
  .form-row:last-of-type { margin-bottom: 12px; }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .form-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.4px;
    color: var(--ink-soft);
    text-transform: uppercase;
  }
  .form-label em {
    color: var(--accent-2);
    font-style: normal;
  }
  .order-form input[type="text"],
  .order-form input[type="number"] {
    width: 100%;
    padding: 12px 14px;
    font: inherit;
    color: var(--ink);
    background: var(--bg);
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    transition: border-color .2s var(--ease), background .2s var(--ease);
  }
  .order-form input:focus {
    outline: none;
    border-color: var(--primary);
    background: var(--white);
    box-shadow: 0 0 0 3px rgba(28, 77, 110, 0.1);
  }
  .order-form input:invalid:not(:placeholder-shown) {
    border-color: var(--accent-2);
  }

  .eyes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  .eye-block {
    border: 1.5px dashed var(--line);
    border-radius: var(--radius);
    padding: 20px;
    margin: 0;
  }
  .eye-block legend {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--primary);
    padding: 0 10px;
  }
  .eye-block .form-row { margin-bottom: 12px; }
  .eye-block .form-row:last-child { margin-bottom: 0; }

  .choices-block {
    border: 1.5px dashed var(--line);
    border-radius: var(--radius);
    padding: 16px 20px 20px;
    margin: 0 0 20px;
  }
  .choices-block legend {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--primary);
    padding: 0 10px;
  }
  .form-hint-inline {
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-mute);
    margin-left: 4px;
  }

  /* ===== Armadura (selección del probador + fallback manual) ===== */
  .armadura-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    margin: 0 0 14px;
    background: var(--primary-soft);
    border: 1.5px solid var(--primary);
    border-radius: var(--radius);
  }
  .armadura-card[hidden] { display: none; }
  .armadura-card__thumb {
    width: 72px;
    height: 40px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--white);
    border-radius: var(--radius-sm, 6px);
    padding: 4px;
  }
  .armadura-card__thumb :global(svg) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }
  .armadura-card__thumb :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .armadura-card__info { min-width: 0; }
  .armadura-card__name {
    margin: 0 0 2px;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.25;
  }
  .armadura-card__price {
    margin: 0;
    font-size: 13px;
    color: var(--primary);
    font-weight: 600;
  }
  .armadura-card__clear {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm, 6px);
    cursor: pointer;
    transition: all .2s var(--ease);
  }
  .armadura-card__clear:hover {
    color: var(--accent-2);
    border-color: var(--accent-2);
  }
  .armadura-hint {
    margin: 0 0 14px;
    font-size: 13px;
    color: var(--ink-mute);
    line-height: 1.5;
  }
  .armadura-hint[hidden] { display: none; }

  .armadura-custom-select {
    position: relative;
    margin: 0 0 14px;
  }
  /* Los estilos de .armadura-custom-select* y .tryon-frame* viven en
     src/styles/styles.css (secciones ARMADURA CUSTOM SELECT y TRYON RAIL)
     porque tanto las opciones del menú como las cards del rail se hidratan
     en el browser vía innerHTML y los estilos scoped de Astro no alcanzan
     a esos elementos. */
  .choices-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: flex-start;
  }
  .choice-item {
    position: relative;
  }
  .choice {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--bg);
    border: 1.5px solid var(--line);
    border-radius: 999px;
    font-size: 14px;
    color: var(--ink-soft);
    cursor: pointer;
    transition: all .2s var(--ease);
    user-select: none;
  }
  /* Choice deshabilitado (ej. Policarbonato / Polarizado no disponibles
   * en la lista de precios actual): grisado, no clickeable para el
   * radio/checkbox, pero el botón ⓘ sigue funcionando para mostrar
   * la descripción. */
  .choice--disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }
  .choice--disabled:hover {
    border-color: var(--line);
    color: var(--ink-soft);
  }
  .choice--disabled input {
    cursor: not-allowed;
  }
  .choice:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .choice input {
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--primary);
    cursor: pointer;
  }
  .choice:has(input:checked) {
    background: var(--primary);
    color: var(--white);
    border-color: var(--primary);
  }
  .choice:has(input:checked) .info-btn {
    color: rgba(255, 255, 255, 0.85);
  }
  .choice:has(input:checked) .info-btn:hover {
    color: var(--white);
    background: rgba(255, 255, 255, 0.15);
  }

  .info-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    margin-left: 4px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-mute);
    cursor: pointer;
    transition: all .2s var(--ease);
  }
  .info-btn:hover {
    background: rgba(10, 31, 92, 0.08);
    color: var(--primary);
  }
  .info-btn svg {
    width: 16px;
    height: 16px;
  }
  .info-btn[aria-expanded="true"] {
    background: var(--primary);
    color: var(--white);
  }

  .choice-info {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: 20;
    width: max-content;
    max-width: 320px;
    min-width: 240px;
    background: var(--ink);
    color: var(--white);
    padding: 12px 14px;
    border-radius: var(--radius);
    font-size: 13px;
    line-height: 1.55;
    box-shadow: var(--shadow-lg);
    text-align: left;
  }
  .choice-info p {
    margin: 0;
  }
  .choice-info::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 18px;
    width: 10px;
    height: 10px;
    background: var(--ink);
    transform: rotate(45deg);
    border-radius: 2px;
  }

  .form-row-3 {
    /* en móvil: 1 col; en tablet+: 3 cols */
  }

  .order-hint {
    font-size: 13px;
    color: var(--ink-mute);
    margin: 0 0 20px;
    text-align: center;
  }
  .order-hint em {
    color: var(--accent-2);
    font-style: normal;
  }

  .order-submit {
    width: 100%;
  }

  /* ===== Precio estimado (live) ===== */
  .order-pricing {
    margin: 0 0 20px;
    padding: 20px;
    background: var(--bg);
    border: 1.5px dashed var(--line);
    border-radius: var(--radius);
  }
  .order-pricing__head {
    margin: 0 0 12px;
  }
  .order-pricing__title {
    margin: 0 0 2px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--primary);
  }
  .order-pricing__sub {
    margin: 0;
    font-size: 12px;
    color: var(--ink-mute);
  }
  .order-pricing__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .order-pricing__body:empty {
    display: none;
  }
  .order-pricing__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 14px;
    color: var(--ink);
    line-height: 1.4;
  }
  .order-pricing__row--addon {
    padding-left: 12px;
    color: var(--ink-soft);
    font-size: 13px;
  }
  .order-pricing__row--armadura {
    color: var(--ink-soft);
    font-size: 13px;
  }
  .order-pricing__row--total {
    margin-top: 6px;
    padding-top: 10px;
    border-top: 1.5px solid var(--line);
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
  }
  .order-pricing__row-label {
    flex: 1;
    min-width: 0;
  }
  .order-pricing__row-note {
    color: var(--ink-mute);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }
  .order-pricing__amount {
    flex-shrink: 0;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .order-pricing__amount-usd {
    font-size: 11px;
    color: var(--ink-mute);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }
  .order-pricing__amount-mn {
    font-weight: 700;
  }
  .order-pricing__rate-note {
    margin: 10px 0 0;
    padding: 8px 10px;
    font-size: 12px;
    color: var(--ink-mute);
    background: rgba(227, 6, 19, 0.06);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius-sm, 6px);
  }

  .order-confirmation {
    margin: 16px 0 0;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--primary);
    background: var(--primary-soft);
    padding: 12px;
    border-radius: var(--radius);
  }

  /* ===== Probador virtual ===== */

  .tryon-callout {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "icon body"
      "btn  btn";
    gap: 16px 20px;
    align-items: center;
    max-width: 880px;
    margin: 0 auto 24px;
    padding: 20px;
    background: linear-gradient(135deg, var(--primary-soft) 0%, var(--bg-alt) 100%);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .tryon-callout__icon {
    grid-area: icon;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--white);
    color: var(--primary);
    border-radius: var(--radius);
    flex-shrink: 0;
  }
  .tryon-callout__icon svg { width: 28px; height: 28px; }
  .tryon-callout__body { grid-area: body; }
  .tryon-callout__title {
    margin: 0 0 4px;
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }
  .tryon-callout__text {
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .tryon-callout__btn {
    grid-area: btn;
    width: 100%;
    justify-content: center;
  }

  /* Modal */
  .tryon-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    padding: 0;
  }
  .tryon-modal[hidden] { display: none; }
  .tryon-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 31, 92, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    cursor: pointer;
  }
  .tryon-modal__panel {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    background: var(--white);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 0;
    box-shadow: none;
    animation: tryon-pop 0.32s var(--ease);
  }
  @keyframes tryon-pop {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Header */
  .tryon-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
    background: var(--white);
    flex-shrink: 0;
  }
  .tryon-header__text { min-width: 0; }
  .tryon-eyebrow {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 2px;
  }
  .tryon-title {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tryon-close {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border: none;
    border-radius: 50%;
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s var(--ease);
  }
  .tryon-close:hover { background: var(--bg-alt); color: var(--accent); }
  .tryon-close:focus-visible {
    outline: 3px solid var(--primary-soft);
    outline-offset: 2px;
  }

  /* Body / Stage */
  .tryon-body {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
  }
  .tryon-stage {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 20px;
  }
  .tryon-stage[hidden] { display: none; }

  /* Empty / upload */
  .tryon-upload {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 16px;
    padding: 24px 12px;
  }
  .tryon-upload__icon {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-xl);
    background: var(--primary-soft);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tryon-upload__icon svg { width: 48px; height: 48px; }
  .tryon-upload__title {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
  }
  .tryon-upload__hint {
    margin: 0;
    max-width: 460px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .tryon-upload__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    max-width: 320px;
    margin-top: 8px;
  }
  .tryon-upload__btn,
  .tryon-upload__btn-secondary {
    width: 100%;
    justify-content: center;
  }

  /* Preview canvas */
  .tryon-canvas {
    position: relative;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 3 / 4;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    align-self: center;
  }
  .tryon-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    background: var(--bg-alt);
    opacity: 1;
    transition: opacity 0.3s var(--ease);
  }
  .tryon-photo.is-loading {
    opacity: 0;
  }
  .tryon-frame-overlay {
    position: absolute;
    top: 32%;
    left: 50%;
    width: 56%;
    /* Composición: centrar + rotate MediaPipe + translate + rotate usuario
       + scale. El orden importa: translate después del rotate MediaPipe
       hace que el drag opere en el frame de la cabeza; el rotate del
       usuario va entre translate y scale para rotar alrededor del centro
       offsetteado; scale al final escala alrededor del nuevo centro. */
    transform: translate(-50%, -50%) rotate(var(--overlay-rotate, 0deg))
               translate(var(--overlay-tx, 0px), var(--overlay-ty, 0px))
               rotate(var(--overlay-rotate-user, 0deg))
               scale(var(--overlay-scale, 1));
    transform-origin: 50% 50%;
    pointer-events: auto;       /* el overlay captura drag/pinch */
    cursor: grab;
    touch-action: none;          /* evita scroll/zoom nativo del browser */
    user-select: none;
    -webkit-user-select: none;
    opacity: 0.92;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.25));
  }
  .tryon-frame-overlay:active { cursor: grabbing; }
  .tryon-frame-overlay :global(svg) { width: 100%; height: auto; display: block; }
  .tryon-frame-overlay :global(img) { width: 100%; height: auto; display: block; }
  .tryon-hint {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: var(--radius);
    font-size: 12px;
    color: var(--ink-soft);
    text-align: center;
  }
  .tryon-replace {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 8px 12px !important;
    font-size: 13px !important;
    background: rgba(255, 255, 255, 0.92) !important;
    color: var(--ink) !important;
    border: 1px solid var(--line) !important;
    box-shadow: var(--shadow-sm);
  }

  /* Reset overlay (devuelve tx/ty/scale a default tras gestos). Aparece
     arriba a la derecha, debajo de "Cambiar foto". */
  .tryon-reset {
    position: absolute;
    top: 56px;
    right: 12px;
    padding: 8px 12px !important;
    font-size: 13px !important;
    background: rgba(255, 255, 255, 0.92) !important;
    color: var(--ink) !important;
    border: 1px solid var(--line) !important;
    box-shadow: var(--shadow-sm);
    z-index: 3;
  }
  .tryon-reset:hover {
    color: var(--primary) !important;
    border-color: var(--primary) !important;
  }

  /* Indicador "Procesando imagen" mientras MediaPipe corre.
   * Solo texto + spinner centrado: nada de overlay borroso encima
   * de la foto (la foto está oculta con opacity:0 vía .is-loading). */
  /* El overlay de la armadura no debe verse hasta que la detección
   * corra y le asigne una posición real sobre los ojos. Antes de eso
   * quedaría flotando en su posición CSS default (top:32%, width:56%)
   * y se ve horrible sobre el canvas en carga. */
  .tryon-canvas.is-detecting .tryon-frame-overlay {
    opacity: 0;
  }
  /* El hint inferior ("Mirá al frente…") se ve raro mientras se procesa,
   * lo ocultamos hasta que tengamos un resultado. */
  .tryon-canvas.is-detecting .tryon-hint {
    display: none;
  }
  /* El botón "Cambiar foto" no tiene sentido mientras se procesa la
   * actual (el indicador cubre todo el canvas); lo ocultamos también. */
  .tryon-canvas.is-detecting .tryon-replace {
    opacity: 0;
    pointer-events: none;
  }
  .tryon-detect-indicator {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 20px;
    text-align: center;
    color: var(--ink);
    pointer-events: none;
  }
  .tryon-detect-indicator[hidden] { display: none; }
  .tryon-detect-indicator__spinner {
    width: 36px;
    height: 36px;
    border: 3px solid var(--primary-soft);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: tryon-spin 0.8s linear infinite;
  }
  @keyframes tryon-spin {
    to { transform: rotate(360deg); }
  }
  .tryon-detect-indicator__title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--ink);
  }

  /* Mensaje "no detectamos una cara" cuando falla la detección. */
  .tryon-detect-msg {
    position: absolute;
    bottom: 56px;
    left: 12px;
    right: 12px;
    z-index: 4;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    font-size: 13px;
    color: var(--ink-soft);
    text-align: center;
    box-shadow: var(--shadow-sm);
  }

  /* Rail de armaduras */
  .tryon-rail-wrap { margin-top: auto; }
  .tryon-rail__label {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-align: center;
  }
  .tryon-rail {
    position: relative;
    padding: 0 44px;
  }
  .tryon-rail__list {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 8px 4px 18px;
    list-style: none;
    margin: 0;
    scrollbar-width: thin;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
  .tryon-rail__list::-webkit-scrollbar { height: 6px; }
  .tryon-rail__list::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
  .tryon-rail__nav {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--white);
    border: 1.5px solid var(--line);
    color: var(--ink);
    cursor: pointer;
    z-index: 2;
    align-items: center;
    justify-content: center;
    padding: 0;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s var(--ease);
  }
  .tryon-rail__nav:hover { background: var(--primary-soft); border-color: var(--primary); }
  .tryon-rail__nav--prev { left: 0; }
  .tryon-rail__nav--next { right: 0; }

  /* Footer */
  .tryon-footer {
    flex-shrink: 0;
