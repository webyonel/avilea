<script>
  import {
    orderToMessage,
    EMPTY_ORDER,
    TREATMENTS,
    parseArmaduraPrecio,
    type CustomOrder,
    type OrderPricing,
  } from '../../lib/orders';
  import { calculateLensPriceUsd, usdToMn } from '../../lib/pricing';
  import { WA_PHONE_ORDERS } from '../../lib/whatsapp';
  import { supabaseBrowser } from '../../lib/admin-auth';

  const form = document.getElementById('orderForm') as HTMLFormElement | null;
  const confirmation = document.getElementById('orderConfirmation');
  const pricingBody = document.querySelector<HTMLElement>('[data-pricing-body]');
  const pricingSub = document.querySelector<HTMLElement>('[data-pricing-sub]');
  const pricingRateNote = document.querySelector<HTMLElement>('[data-pricing-rate-note]');
  const progresivoWrap = document.querySelector<HTMLElement>('[data-progresivo-wrap]');

  /** Tasa USD → MN que configura el admin. Null hasta que se carga. */
  let usdRate: number | null = null;

  /** Trae la tasa USD/MN configurada por el admin en `settings.usd_rate`. */
  async function loadUsdRate(): Promise<void> {
    try {
      const { data, error } = await supabaseBrowser
        .from('settings')
        .select('value')
        .eq('key', 'usd_rate')
        .maybeSingle();
      if (error || !data) return;
      const v = (data as { value: unknown }).value;
      if (typeof v === 'number' && Number.isFinite(v) && v > 0) {
        usdRate = v;
      }
    } catch {
      /* ignore — la web funciona sin tasa, solo no muestra MN */
    } finally {
      updatePricingDisplay();
    }
  }
  loadUsdRate();

  function readField(data: FormData, key: string): string {
    return String(data.get(key) ?? '').trim();
  }

  /** Lee el estado actual del form y devuelve el CustomOrder listo para
   *  pricing / WhatsApp. */
  function readOrder(): CustomOrder {
    if (!form) return { ...EMPTY_ORDER };
    const data = new FormData(form);
    return {
      ...EMPTY_ORDER,
      fullName: readField(data, 'fullName'),
      ci: readField(data, 'ci'),
      armaduraId: (() => {
        const v = readField(data, 'armaduraId');
        return v === '' ? null : v;
      })(),
      armaduraNombre: readField(data, 'armaduraNombre'),
      armaduraPrecio: readField(data, 'armaduraPrecio'),
      material: (readField(data, 'material') || '') as CustomOrder['material'],
      treatments: data.getAll('tratamiento').map(String) as CustomOrder['treatments'],
      focalDistances: data.getAll('focal').map(String) as CustomOrder['focalDistances'],
      progresivoIndex: (readField(data, 'progresivoIndex') || '') as CustomOrder['progresivoIndex'],
      rightEye: {
        esfera: readField(data, 'od.esfera'),
        cilindro: readField(data, 'od.cilindro'),
        eje: readField(data, 'od.eje'),
        prisma: readField(data, 'od.prisma'),
        base: readField(data, 'od.base'),
      },
      leftEye: {
        esfera: readField(data, 'oi.esfera'),
        cilindro: readField(data, 'oi.cilindro'),
        eje: readField(data, 'oi.eje'),
        prisma: readField(data, 'oi.prisma'),
        base: readField(data, 'oi.base'),
      },
      adicion: readField(data, 'adicion'),
      distanciaPupilar: readField(data, 'distanciaPupilar'),
      ejeAstigmatismo: readField(data, 'ejeAstigmatismo'),
    };
  }

  /** Etiqueta humana para un treatment (usado en el desglose). */
  function treatmentLabel(t: string): string {
    return TREATMENTS.find((x) => x.value === t)?.label ?? t;
  }

  /** Construye el OrderPricing listo para mostrar + para mandar por WhatsApp. */
  function computePricing(order: CustomOrder): OrderPricing | null {
    const lens = calculateLensPriceUsd(order);
    if (!lens) return null;
    const armaduraMn = parseArmaduraPrecio(order.armaduraPrecio);
    const lensMn = usdToMn(lens.totalUsd, usdRate);
    let totalMn: number | null = null;
    if (lensMn !== null && armaduraMn !== null) totalMn = lensMn + armaduraMn;
    return {
      lens: {
        baseUsd: lens.basePriceUsd,
        addOns: lens.appliedAddOns.map((a) => ({ treatment: treatmentLabel(a.treatment), priceUsd: a.priceUsd })),
        totalUsd: lens.totalUsd,
        configLabel: lens.configLabel,
        prescriptionRange: lens.prescriptionRange,
      },
      armaduraMn,
      usdRate,
      lensMn,
      totalMn,
    };
  }

  /** Helper de formato (es-CU para coma de miles). */
  const fmtMn = (n: number) => n.toLocaleString('es-CU');
  const fmtUsd = (n: number) => `${n} USD`;

  /** Pinta el desglose en `data-pricing-body`. */
  function renderPricing(): void {
    if (!pricingBody || !pricingSub || !pricingRateNote) return;
    const order = readOrder();
    const pricing = computePricing(order);

    // Sin material+focal todavía → mensaje de ayuda
    if (!pricing) {
      pricingBody.innerHTML = '';
      pricingSub.textContent = 'Elegí material y distancia focal para ver el precio.';
      pricingSub.hidden = false;
      pricingRateNote.hidden = true;
      return;
    }

    pricingSub.hidden = true;
    pricingRateNote.hidden = usdRate !== null;

    if (usdRate === null) {
      pricingRateNote.hidden = false;
      pricingRateNote.textContent =
        'Aún no configuraste la tasa USD → MN desde el panel admin. Mostramos el equivalente solo en USD.';
    }

    const rows: string[] = [];

    // Lente base
    rows.push(`
      <div class="order-pricing__row">
        <div class="order-pricing__row-label">
          <div>Lente (${escapeHtml(pricing.lens.configLabel)})</div>
          <div class="order-pricing__row-note">${escapeHtml(pricing.lens.prescriptionRange)}</div>
        </div>
        <div class="order-pricing__amount">
          ${pricing.lensMn !== null
            ? `<div class="order-pricing__amount-mn">${fmtMn(pricing.lensMn)} MN</div>
               <div class="order-pricing__amount-usd">${fmtUsd(pricing.lens.baseUsd)}</div>`
            : `<div class="order-pricing__amount-mn">${fmtUsd(pricing.lens.baseUsd)}</div>`}
        </div>
      </div>
    `);

    // Add-ons
    for (const a of pricing.lens.addOns) {
      const aUsd = a.priceUsd;
      const aMn = usdToMn(aUsd, usdRate);
      rows.push(`
        <div class="order-pricing__row order-pricing__row--addon">
          <div class="order-pricing__row-label">+ ${escapeHtml(a.treatment)}</div>
          <div class="order-pricing__amount">
            ${aMn !== null
              ? `<div class="order-pricing__amount-mn">${fmtMn(aMn)} MN</div>
                 <div class="order-pricing__amount-usd">+${fmtUsd(aUsd)}</div>`
              : `<div class="order-pricing__amount-mn">+${fmtUsd(aUsd)}</div>`}
          </div>
        </div>
      `);
    }

    // Subtotal lente (solo si hay add-ons)
    if (pricing.lens.addOns.length > 0) {
      rows.push(`
        <div class="order-pricing__row order-pricing__row--subtotal">
          <div class="order-pricing__row-label">Subtotal lente</div>
          <div class="order-pricing__amount">
            ${pricing.lensMn !== null
              ? `<div class="order-pricing__amount-mn">${fmtMn(pricing.lensMn)} MN</div>
                 <div class="order-pricing__amount-usd">${fmtUsd(pricing.lens.totalUsd)}</div>`
              : `<div class="order-pricing__amount-mn">${fmtUsd(pricing.lens.totalUsd)}</div>`}
          </div>
        </div>
      `);
    }

    // Armadura
    if (pricing.armaduraMn !== null) {
      rows.push(`
        <div class="order-pricing__row order-pricing__row--armadura">
          <div class="order-pricing__row-label">Armadura</div>
          <div class="order-pricing__amount">
            <div class="order-pricing__amount-mn">${fmtMn(pricing.armaduraMn)} MN</div>
          </div>
        </div>
      `);
    } else {
      rows.push(`
        <div class="order-pricing__row order-pricing__row--armadura">
          <div class="order-pricing__row-label">Armadura</div>
          <div class="order-pricing__amount order-pricing__amount-usd">— (elegila arriba o tipeá el precio)</div>
        </div>
      `);
    }

    // Total (solo si tenemos lente + armadura en MN)
    if (pricing.totalMn !== null) {
      const totalUsd = pricing.armaduraMn !== null && usdRate
        ? (pricing.armaduraMn / usdRate) + pricing.lens.totalUsd
        : null;
      rows.push(`
        <div class="order-pricing__row order-pricing__row--total">
          <div class="order-pricing__row-label">TOTAL</div>
          <div class="order-pricing__amount">
            <div class="order-pricing__amount-mn">${fmtMn(pricing.totalMn)} MN</div>
            ${totalUsd !== null
              ? `<div class="order-pricing__amount-usd">~${totalUsd.toFixed(2)} USD</div>`
              : ''}
          </div>
        </div>
      `);
    }

    pricingBody.innerHTML = rows.join('');
  }

  /** Wrapper público para re-pintar (lo llama loadUsdRate al llegar la tasa). */
  function updatePricingDisplay() {
    renderPricing();
  }

  /** Escapa texto para insertar vía innerHTML. */
  function escapeHtml(s: string): string {
    return s.replace(/[&"<>]/g, (c) =>
      ({ '&': '&amp;', '"': '&quot;', '<': '&lt;', '>': '&gt;' }[c] as string),
    );
  }

  /** Mostrar/ocultar el bloque de índice progresivo según el checkbox. */
  function syncProgresivoVisibility() {
    if (!progresivoWrap || !form) return;
    const checked = form.querySelector<HTMLInputElement>('input[name="focal"][value="progresivo"]:checked');
    progresivoWrap.hidden = !checked;
    if (!checked) {
      // Limpiar selección previa del índice para no contaminar el mensaje.
      form.querySelectorAll<HTMLInputElement>('input[name="progresivoIndex"]').forEach((r) => (r.checked = false));
    }
  }

  // Popovers de descripción: toggle al click del botón ⓘ.
  // stopPropagation evita que el click se propague al <label> y togglee el radio/checkbox.
  function closeAllInfos() {
    document.querySelectorAll<HTMLElement>('.choice-info').forEach((el) => el.setAttribute('hidden', ''));
    document.querySelectorAll<HTMLButtonElement>('.info-btn').forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
  }

  document.querySelectorAll<HTMLButtonElement>('.info-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const item = btn.closest('.choice-item');
      const info = item?.querySelector<HTMLElement>('.choice-info');
      if (!info) return;
      const wasOpen = !info.hasAttribute('hidden');
      closeAllInfos();
      if (!wasOpen) {
        info.removeAttribute('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Click fuera cierra cualquier popover abierto.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('.choice-item')) closeAllInfos();
  });

  // Escape también cierra.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllInfos();
  });

  if (form) {
    // Live pricing: cada cambio relevante re-pinta el desglose.
    form.addEventListener('input', () => {
      syncProgresivoVisibility();
      updatePricingDisplay();
    });
    form.addEventListener('change', () => {
      syncProgresivoVisibility();
      updatePricingDisplay();
    });
    syncProgresivoVisibility();
    updatePricingDisplay();

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Validación nativa del browser (required en fullName y ci).
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const order = readOrder();
      const pricing = computePricing(order);

      closeAllInfos();

      const message = orderToMessage(order, pricing);
      const link = `https://wa.me/${WA_PHONE_ORDERS}?text=${encodeURIComponent(message)}`;
      window.open(link, '_blank', 'noopener');

      form.reset();
      if (confirmation) {
        confirmation.hidden = false;
        confirmation.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  }
</script>

<script>
  // Probador virtual: abrir/cerrar modal, file → preview, swap de armadura.
  // Y ahora también detección de cara/ojos (MediaPipe Face Landmarker)
  // para posicionar la armadura sobre los ojos del usuario.
  import {
    preloadFaceLandmarker,
    detectFaceInPhoto,
    computeOverlayPosition,
    applyOverlayPosition,
    resetOverlayPosition,
  } from '../../lib/tryon-face-detection';
  import { renderShape } from '../../lib/svgShapes';
  import type { Shape } from '../../lib/catalog';
  import { sharedFetchProducts } from '../../lib/products-runtime-cache';
  import {
    renderTryonFrame,
    renderArmaduraOption,
    filterTryOnFrames,
    filterCatalogFrames,
  } from '../../lib/render-cards';
  import { createOverlayGestureController } from '../../lib/tryon-gestures';

  // Preload del modelo: lo arrancamos DESPUÉS de que el catálogo termine de
  // cargar, para no competir con la consulta a Supabase por el ancho de
  // banda del dispositivo. El catálogo se dispara apenas se parsea el <head>
  // (ver Layout.astro → preload inline), así que normalmente esto se resuelve
  // en pocos cientos de ms. Si el catálogo falla (red, Supabase caído), un
  // fallback de 6s igual dispara el preload para no romper el probador.
  {
    const onCatalogReady = () => {
      clearTimeout(fallback);
      window.removeEventListener('avilea:catalog-ready', onCatalogReady);
      preloadFaceLandmarker();
    };
    if (window.__avileaProductsLoaded) {
      preloadFaceLandmarker();
    } else {
      window.addEventListener('avilea:catalog-ready', onCatalogReady);
      const fallback = window.setTimeout(onCatalogReady, 6000);
    }
  }

  {
    const modal = document.getElementById('tryonModal');
    if (!modal) {
      // Si no hay modal, este bloque no hace nada (página sin #pedido).
    } else {
      const openBtns = document.querySelectorAll<HTMLButtonElement>('[data-tryon-open]');
      const closeBtns = modal.querySelectorAll<HTMLElement>('[data-tryon-close]');
      const fileInput = modal.querySelector<HTMLInputElement>('[data-tryon-file]');
      const cameraBtn = modal.querySelector<HTMLButtonElement>('[data-tryon-camera]');
      const replaceBtn = modal.querySelector<HTMLButtonElement>('[data-tryon-replace]');
      const resetBtn = modal.querySelector<HTMLButtonElement>('[data-tryon-reset]');
      const jumpBtn = modal.querySelector<HTMLButtonElement>('[data-tryon-jump]');
      const stageEmpty = modal.querySelector<HTMLElement>('[data-stage="empty"]');
      const stagePreview = modal.querySelector<HTMLElement>('[data-stage="preview"]');
      const photo = modal.querySelector<HTMLImageElement>('.tryon-photo');
      const overlay = modal.querySelector<HTMLElement>('[data-frame-overlay]');
      const titleEl = modal.querySelector<HTMLElement>('#tryonTitle');
      const railList = modal.querySelector<HTMLElement>('.tryon-rail__list');
      const railPrev = modal.querySelector<HTMLButtonElement>('[data-tryon-rail-prev]');
      const railNext = modal.querySelector<HTMLButtonElement>('[data-tryon-rail-next]');
      const orderForm = document.getElementById('orderForm');
      const canvas = modal.querySelector<HTMLElement>('.tryon-canvas');

      // ============ Gesture controller del overlay ============
      // Permite arrastrar (1 dedo/mouse) y escalar (pinch 2 dedos / wheel)
      // la armadura sobre la foto. El estado (tx/ty/scale) es compartido
      // entre armaduras: si ajustás una, las demás heredan ese offset.
      // Se compone sobre el resultado de MediaPipe vía CSS vars
      // (--overlay-tx/ty/scale). Ver src/lib/tryon-gestures.ts.
      const overlayGesture = (overlay && canvas)
        ? createOverlayGestureController({
            overlayEl: overlay,
            canvasEl: canvas,
            onChange: (adj) => {
              overlay!.style.setProperty('--overlay-tx', `${adj.tx}px`);
              overlay!.style.setProperty('--overlay-ty', `${adj.ty}px`);
              overlay!.style.setProperty('--overlay-scale', String(adj.scale));
              overlay!.style.setProperty('--overlay-rotate-user', `${adj.rotation}deg`);
            },
          })
        : null;
      overlayGesture?.start();
      resetBtn?.addEventListener('click', () => overlayGesture?.reset());

      // Las armaduras del rail y las opciones del menú se inyectan runtime
      // vía sharedFetchProducts. Helpers que consultan el DOM en el momento
      // (no capturan NodeList al inicio) para ver siempre los items actuales.
      const getFrames = () => modal.querySelectorAll<HTMLButtonElement>('.tryon-frame');

      // Sincronización armadura ↔ formulario (selección del probador).
      const armaduraCard = orderForm?.querySelector<HTMLElement>('[data-armadura-card]');
      const armaduraThumb = orderForm?.querySelector<HTMLElement>('[data-armadura-thumb]');
      const armaduraName = orderForm?.querySelector<HTMLElement>('[data-armadura-name]');
      const armaduraPrice = orderForm?.querySelector<HTMLElement>('[data-armadura-price]');
      const armaduraHint = orderForm?.querySelector<HTMLElement>('[data-armadura-hint]');
      const armaduraIdInput = orderForm?.querySelector<HTMLInputElement>('[data-armadura-id]');
      const armaduraManualName = orderForm?.querySelector<HTMLInputElement>('[data-armadura-manual-name]');
      const armaduraManualPrice = orderForm?.querySelector<HTMLInputElement>('[data-armadura-manual-price]');
      const armaduraClearBtn = orderForm?.querySelector<HTMLButtonElement>('[data-armadura-clear]');

      // Custom select (trigger + menú flotante) — reemplaza al <select> nativo.
      const armaduraSelectWrap = orderForm?.querySelector<HTMLElement>('[data-armadura-select-wrap]');
      const armaduraSelectTrigger = orderForm?.querySelector<HTMLButtonElement>('[data-armadura-select-trigger]');
      const armaduraSelectThumb = orderForm?.querySelector<HTMLElement>('[data-armadura-select-thumb]');
      const armaduraSelectName = orderForm?.querySelector<HTMLElement>('[data-armadura-select-name]');
      const armaduraSelectPrice = orderForm?.querySelector<HTMLElement>('[data-armadura-select-price]');
      const armaduraSelectMenu = orderForm?.querySelector<HTMLElement>('[data-armadura-select-menu]');
      const getOptions = () =>
        armaduraSelectMenu?.querySelectorAll<HTMLButtonElement>('[data-armadura-option]') ??
        ([] as unknown as NodeListOf<HTMLButtonElement>);

      // Shapes válidas para renderizar SVG de armadura en el thumb de la card.
      // Si el producto elegido del catálogo no es una armadura (ej. accesorio),
      // mostramos solo nombre + precio sin thumb.
      const FRAME_SHAPES_RUNTIME: readonly string[] = [
        'round', 'cat', 'rect', 'square', 'rimless', 'aviator', 'wayfarer',
      ];

      // ============ Hidratación del catálogo (runtime) ============
      // Trae productos de Supabase una sola vez (compartido vía cache) y los
      // inyecta en el rail del probador + el menú del custom-select del
      // formulario. Los handlers de click ya están delegados sobre los
      // contenedores (railList, armaduraSelectMenu), así que aplican a los
      // elementos nuevos sin re-bindear.
      sharedFetchProducts()
        .then((all) => {
          const tryOnProducts = filterTryOnFrames(all);
          const catalogFrames = filterCatalogFrames(all);

          if (railList) {
            railList.innerHTML = tryOnProducts.length
              ? tryOnProducts.map(renderTryonFrame).join('')
              : `<li class="runtime-empty" role="status"><p>Todavía no hay armaduras cargadas para probar.</p></li>`;
            checkRailOverflow();
          }

          if (armaduraSelectMenu) {
            armaduraSelectMenu.innerHTML = catalogFrames.length
              ? catalogFrames.map(renderArmaduraOption).join('')
              : `<li class="runtime-empty" role="status"><p>No hay armaduras en el catálogo.</p></li>`;
          }

          // Si el modal ya estaba abierto y esperando, ahora sí hay frames.
          if (!stagePreview?.hidden && overlay && getFrames().length) {
            selectFrame(getFrames()[0].dataset.frameId || '');
          }

          window.dispatchEvent(new CustomEvent('avilea:reveal-refresh'));
        })
        .catch((e) => {
          const msg = e instanceof Error ? e.message : 'Error desconocido al cargar el catálogo.';
          console.error('[order-form] sharedFetchProducts failed:', msg);
          if (railList) {
            railList.innerHTML = `<li class="runtime-error-inline" role="alert"><p>No pudimos cargar las armaduras.</p></li>`;
          }
          if (armaduraSelectMenu) {
            armaduraSelectMenu.innerHTML = `<li class="runtime-error-inline" role="alert"><p>No pudimos cargar el catálogo.</p></li>`;
          }
        });

      /** Pinta el thumb del trigger con imagen real o SVG por forma. */
      function setTriggerThumb(image: string, shape: string, color: string) {
        if (!armaduraSelectThumb) return;
        let html = '';
        if (image) {
          html = `<img src="${escapeHtmlAttr(image)}" alt="" />`;
        } else if (shape && FRAME_SHAPES_RUNTIME.includes(shape)) {
          html = renderShape(shape as Shape, color);
        }
        armaduraSelectThumb.innerHTML = html;
      }

      function syncArmaduraFromTryon(id: string) {
        const btn = modal.querySelector<HTMLButtonElement>(
          `.tryon-frame[data-frame-id="${CSS.escape(id)}"]`,
        );
        if (!btn || !armaduraCard || !armaduraIdInput) return;
        const name = btn.dataset.frameName || '';
        const priceRaw = btn.dataset.framePrice || '';
        const priceNum = Number(priceRaw);
        const priceStr = Number.isFinite(priceNum) && priceNum > 0
          ? priceNum.toLocaleString('es-ES')
          : priceRaw;
        const shape = btn.dataset.shape || '';
        const color = btn.dataset.color || '#0a1f5c';
        const image = btn.dataset.frameImage || '';

        // ID oculto
        armaduraIdInput.value = id;
        // Card visible con thumb + nombre + precio
        const thumb = btn.querySelector<HTMLElement>('.tryon-frame__thumb');
        if (armaduraThumb && thumb) armaduraThumb.innerHTML = thumb.innerHTML;
        if (armaduraName) armaduraName.textContent = name;
        if (armaduraPrice) armaduraPrice.textContent = priceStr ? `${priceStr} MN` : '';
        armaduraCard.hidden = false;
        if (armaduraHint) armaduraHint.hidden = true;
        // Autofill de los inputs manuales (el cliente puede editarlos si quiere)
        if (armaduraManualName) armaduraManualName.value = name;
        if (armaduraManualPrice && priceStr) armaduraManualPrice.value = priceStr;
        // Reflejar la selección en el trigger del custom select
        if (armaduraSelectName) armaduraSelectName.textContent = name;
        if (armaduraSelectPrice) {
          armaduraSelectPrice.textContent = priceStr ? `${priceStr} MN` : '—';
        }
        setTriggerThumb(image, shape, color);
        if (armaduraSelectWrap) armaduraSelectWrap.classList.add('armadura-custom-select--selected');
        // Marcar la opción correspondiente del menú (si existe)
        getOptions().forEach((o) => {
          o.setAttribute('aria-selected', o.dataset.value === id ? 'true' : 'false');
        });
      }

      function clearArmaduraFromForm() {
        if (armaduraIdInput) armaduraIdInput.value = '';
        if (armaduraCard) armaduraCard.hidden = true;
        if (armaduraHint) armaduraHint.hidden = false;
        if (armaduraManualName) armaduraManualName.value = '';
        if (armaduraManualPrice) armaduraManualPrice.value = '';
        // Reset del trigger del custom select a su estado placeholder
        if (armaduraSelectName) armaduraSelectName.textContent = 'Elegí una armadura del catálogo';
        if (armaduraSelectPrice) armaduraSelectPrice.textContent = 'o usá el probador arriba';
        if (armaduraSelectThumb) armaduraSelectThumb.innerHTML = '';
        if (armaduraSelectWrap) armaduraSelectWrap.classList.remove('armadura-custom-select--selected');
        getOptions().forEach((o) => o.setAttribute('aria-selected', 'false'));
        closeArmaduraMenu();
      }

      armaduraClearBtn?.addEventListener('click', clearArmaduraFromForm);

      // Sincronización armadura desde una opción del menú del catálogo (sin probador).
      function syncArmaduraFromCatalog(opt: HTMLButtonElement) {
        if (!armaduraCard || !armaduraIdInput) return;
        const id = opt.dataset.value || '';
        const name = opt.dataset.name || '';
        const priceRaw = opt.dataset.price || '';
        const priceNum = Number(priceRaw);
        const priceStr = Number.isFinite(priceNum) && priceNum > 0
          ? priceNum.toLocaleString('es-ES')
          : '';
        const shape = opt.dataset.shape || '';
        const color = opt.dataset.color || '#0a1f5c';
        const image = opt.dataset.image || '';

        armaduraIdInput.value = id;

        // Thumb en la card: preferimos imagen real; si no, SVG por forma.
        let thumbHtml = '';
        if (image) {
          thumbHtml = `<img src="${escapeHtmlAttr(image)}" alt="" />`;
        } else if (shape && FRAME_SHAPES_RUNTIME.includes(shape)) {
          thumbHtml = renderShape(shape as Shape, color);
        }
        if (armaduraThumb) armaduraThumb.innerHTML = thumbHtml;

        if (armaduraName) armaduraName.textContent = name;
        if (armaduraPrice) armaduraPrice.textContent = priceStr ? `${priceStr} MN` : '';
        armaduraCard.hidden = false;
        if (armaduraHint) armaduraHint.hidden = true;
        if (armaduraManualName) armaduraManualName.value = name;
        if (armaduraManualPrice && priceStr) armaduraManualPrice.value = priceStr;

        // Reflejar la selección en el trigger del custom select
        if (armaduraSelectName) armaduraSelectName.textContent = name;
        if (armaduraSelectPrice) {
          armaduraSelectPrice.textContent = priceStr ? `${priceStr} MN` : '—';
        }
        setTriggerThumb(image, shape, color);
        if (armaduraSelectWrap) armaduraSelectWrap.classList.add('armadura-custom-select--selected');
        // Marcar la opción clickeada como seleccionada en el menú
        getOptions().forEach((o) => {
          o.setAttribute('aria-selected', o === opt ? 'true' : 'false');
        });
      }

      // ----- Custom select: abrir/cerrar menú + selección de opción -----

      function openArmaduraMenu() {
        if (!armaduraSelectMenu || !armaduraSelectTrigger) return;
        armaduraSelectMenu.hidden = false;
        armaduraSelectTrigger.setAttribute('aria-expanded', 'true');
      }

      function closeArmaduraMenu() {
        if (!armaduraSelectMenu || !armaduraSelectTrigger) return;
        armaduraSelectMenu.hidden = true;
        armaduraSelectTrigger.setAttribute('aria-expanded', 'false');
      }

      function toggleArmaduraMenu() {
        if (!armaduraSelectMenu) return;
        if (armaduraSelectMenu.hidden) openArmaduraMenu();
        else closeArmaduraMenu();
      }

      armaduraSelectTrigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleArmaduraMenu();
      });

      // Click delegado sobre el menú: funciona para opciones inyectadas
      // en runtime por el script que carga el catálogo.
      armaduraSelectMenu?.addEventListener('click', (e) => {
        const opt = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-armadura-option]');
        if (!opt) return;
        e.stopPropagation();
        syncArmaduraFromCatalog(opt);
        closeArmaduraMenu();
        // Devolver foco al trigger para accesibilidad
        armaduraSelectTrigger?.focus();
      });

      // Click fuera del wrapper cierra el menú
      document.addEventListener('click', (e) => {
        if (!armaduraSelectWrap) return;
        const target = e.target as Node;
        if (!armaduraSelectWrap.contains(target)) closeArmaduraMenu();
      });

      // Escape cierra el menú
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && armaduraSelectMenu && !armaduraSelectMenu.hidden) {
          closeArmaduraMenu();
          armaduraSelectTrigger?.focus();
        }
      });

      let lastFocus: HTMLElement | null = null;

      function openTryOn() {
        if (!modal) return;
        lastFocus = document.activeElement as HTMLElement | null;
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        modal.querySelector<HTMLButtonElement>('.tryon-close')?.focus();
        // Armadura por defecto al abrir en preview (si ya hay foto previa no, queda como está).
        if (!stagePreview?.hidden && getFrames().length && overlay) {
          selectFrame(getFrames()[0].dataset.frameId || '');
        }
        // Empezamos a bajar MediaPipe en background para que esté listo
        // cuando el usuario suba la primera foto.
        preloadFaceLandmarker();
      }

      function closeTryOn() {
        if (!modal) return;
        modal.hidden = true;
        document.body.style.overflow = '';
        lastFocus?.focus?.();
      }

      /* ---------- Estados de detección (loading / sin cara) ---------- */

      function ensureIndicator(): HTMLElement | null {
        if (!canvas) return null;
        let indicator = canvas.querySelector<HTMLElement>('.tryon-detect-indicator');
        if (!indicator) {
          indicator = document.createElement('div');
          indicator.className = 'tryon-detect-indicator';
          indicator.setAttribute('role', 'status');
          indicator.setAttribute('aria-live', 'polite');
          indicator.innerHTML =
            '<div class="tryon-detect-indicator__spinner" aria-hidden="true"></div>' +
            '<p class="tryon-detect-indicator__title">Procesando imagen</p>';
          canvas.appendChild(indicator);
        }
        return indicator;
      }

      function setDetecting(on: boolean) {
        if (!canvas) return;
        canvas.classList.toggle('is-detecting', on);
        const indicator = ensureIndicator();
        if (!indicator) return;
        indicator.hidden = !on;
      }

      function setDetectionMessage(msg: string | null) {
        if (!canvas) return;
        let el = canvas.querySelector<HTMLElement>('.tryon-detect-msg');
        if (!msg) {
          el?.remove();
          return;
        }
        if (!el) {
          el = document.createElement('div');
          el.className = 'tryon-detect-msg';
          canvas.appendChild(el);
        }
        el.textContent = msg;
      }

      async function processPhoto() {
        if (!photo || !canvas || !overlay) return;
        setDetecting(true);
        setDetectionMessage(null);
        // Ocultamos la foto del usuario hasta que la detección termine
        // (con o sin éxito). Así no se ve la cara "sola" mientras el
        // detector corre, y aparece ya lista con el overlay encima.
        photo.classList.add('is-loading');

        // Asegurarnos de que la imagen ya tiene dimensiones (onload previo).
        if (!photo.complete || photo.naturalWidth === 0) {
          await new Promise<void>((resolve) => {
            const onDone = () => {
              photo!.removeEventListener('load', onDone);
              photo!.removeEventListener('error', onDone);
              resolve();
            };
            photo!.addEventListener('load', onDone);
            photo!.addEventListener('error', onDone);
          });
        }

        const result = await detectFaceInPhoto(photo);

        // Detección terminada (éxito o no). Revelamos la foto y limpiamos
        // el indicador.
        photo.classList.remove('is-loading');
        setDetecting(false);

        if (result.found) {
          const position = computeOverlayPosition(result.landmarks, photo, canvas);
          applyOverlayPosition(overlay, position);
        } else {
          resetOverlayPosition(overlay);
          setDetectionMessage(
            'No detectamos una cara mirando al frente. Probá con otra foto más clara.'
          );
        }
      }

      function showPhotoPreview(file: File | undefined) {
        if (!file || !file.type.startsWith('image/')) return;
        if (!photo || !stageEmpty || !stagePreview || !overlay) return;
        const url = URL.createObjectURL(file);
        // Resetear posición al cargar (mientras se detecta).
        resetOverlayPosition(overlay);
        setDetectionMessage(null);
        setDetecting(true);

        photo.onload = () => {
          URL.revokeObjectURL(url);
          processPhoto();
        };
        photo.src = url;

        stageEmpty.hidden = true;
        stagePreview.hidden = false;
        if (getFrames().length) {
          selectFrame(getFrames()[0].dataset.frameId || '');
        }
        // Llevar scroll al inicio del preview.
        modal.querySelector('.tryon-body')?.scrollTo({ top: 0 });
      }

      function selectFrame(id: string) {
        if (!overlay) return;
        const btn = modal.querySelector<HTMLButtonElement>(
          `.tryon-frame[data-frame-id="${CSS.escape(id)}"]`,
        );
        if (!btn) return;
        getFrames().forEach((f) => {
          const active = f.dataset.frameId === id;
          f.classList.toggle('tryon-frame--active', active);
          f.setAttribute('aria-checked', active ? 'true' : 'false');
        });
        const thumb = btn.querySelector<HTMLElement>('.tryon-frame__thumb');
        const color = btn.dataset.color || '#0a1f5c';
        const imageSrc = btn.dataset.frameImage || '';
        // Preferimos la imagen real del producto si está cargada (PNG
        // transparente). Si no, caemos al SVG generado por forma+color.
        if (imageSrc) {
          overlay.innerHTML = `<img src="${escapeHtmlAttr(imageSrc)}" alt="" />`;
        } else {
          const svg = thumb?.innerHTML ?? '';
          overlay.innerHTML = svg;
        }
        overlay.style.setProperty('--frame-color', color);
        const name = btn.querySelector<HTMLElement>('.tryon-frame__name')?.textContent?.trim();
        if (name && titleEl) titleEl.textContent = name;
        // Sincronizar el formulario con la armadura seleccionada del probador.
        syncArmaduraFromTryon(id);
        // Centrar la selección en el rail.
        btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      }

      /** Escapa comillas y & para usar en atributos HTML seteados vía innerHTML. */
      function escapeHtmlAttr(s: string): string {
        return s.replace(/[&"<>]/g, (c) =>
          ({ '&': '&amp;', '"': '&quot;', '<': '&lt;', '>': '&gt;' }[c] as string)
        );
      }

      function checkRailOverflow() {
        if (!railList) return;
        const navs = modal.querySelectorAll<HTMLButtonElement>('.tryon-rail__nav');
        const overflow = railList.scrollWidth > railList.clientWidth + 2;
        navs.forEach((n) => (n.dataset.overflow = overflow ? 'true' : 'false'));
      }

      openBtns.forEach((b) => b.addEventListener('click', openTryOn));
      closeBtns.forEach((b) => b.addEventListener('click', closeTryOn));

      // Capturar cámara frontal en móvil: reconstruimos el input con capture="user".
      cameraBtn?.addEventListener('click', () => {
        if (!fileInput) return;
        fileInput.setAttribute('capture', 'user');
        fileInput.click();
        // Limpiar capture para que el siguiente "Elegir foto" permita galería.
        setTimeout(() => fileInput.removeAttribute('capture'), 0);
      });

      fileInput?.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        showPhotoPreview(file);
      });

      replaceBtn?.addEventListener('click', () => fileInput?.click());

      // Click delegado sobre el rail: funciona para armaduras inyectadas
      // en runtime por el script que carga el catálogo.
      railList?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.tryon-frame');
        if (!btn) return;
        selectFrame(btn.dataset.frameId || '');
      });

      railPrev?.addEventListener('click', () =>
        railList?.scrollBy({ left: -220, behavior: 'smooth' }),
      );
      railNext?.addEventListener('click', () =>
        railList?.scrollBy({ left: 220, behavior: 'smooth' }),
      );

      jumpBtn?.addEventListener('click', () => {
        closeTryOn();
        orderForm?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.hidden) closeTryOn();
      });

      window.addEventListener('resize', checkRailOverflow);
      // Chequear al cargar (puede haber carrusel con overflow ya en render).
      requestAnimationFrame(checkRailOverflow);
    }
  }
</script>
