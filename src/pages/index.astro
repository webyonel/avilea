---
// src/pages/index.astro
// Página pública principal.
// Fase 2 → runtime: el catálogo de productos se hidrata en el browser
// desde Supabase (ver Catalog.astro → fetchProductsBrowser). El sitio
// público ya no hace fetch en build-time, así que los cambios del admin
// se ven sin redeploy.

import Layout from '../layouts/Layout.astro';
import Hero from '../components/public/Hero.astro';
import Catalog from '../components/public/Catalog.astro';
import CustomOrderForm from '../components/public/CustomOrderForm.astro';
import Contact from '../components/public/Contact.astro';
---

<Layout
  title="Avilea · Óptica familiar en Ciego de Ávila, Ciro Redondo y Morón"
  description="Avilea es una óptica cubana con 3 locales: Ciego de Ávila, Ciro Redondo y Morón. Armaduras graduadas a medida, cristales hechos en laboratorio propio, accesorios y atención personalizada. Prueba cómo te quedan con nuestro probador virtual."
>
  <Hero />
  <Catalog />
  <CustomOrderForm />
  <Contact />
</Layout>
