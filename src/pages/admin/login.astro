---
// src/pages/admin/login.astro
// Pantalla de login · Fase 2 (Supabase Auth).
// Standalone (sin Layout público). Si ya hay sesión vigente, el cliente
// redirige a /admin.

import '../../styles/styles.css';
import '../../styles/admin.css';

// BASE_URL puede no traer trailing slash → normalizamos a `base/`.
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Avilea · Panel de Administración</title>
    <link rel="icon" type="image/webp" href={`${base}logo.webp`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <section class="login-screen">
      <div class="login-bg">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
      </div>

      <div class="login-card">
        <a href={base} class="logo-center" aria-label="Avilea · Inicio">
          <img src={`${base}logo.webp`} alt="Avilea Óptica" class="login-logo" width="180" height="180" />
          <span class="login-logo-sub">Panel Admin</span>
        </a>

        <div class="login-head">
          <h1>Bienvenido de vuelta</h1>
          <p>Accede al panel de administración para gestionar el catálogo.</p>
        </div>

        <form class="login-form" id="loginForm" novalidate>
          <div class="field">
            <label for="loginEmail">Correo electrónico</label>
            <div class="input-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <input type="email" id="loginEmail" placeholder="tu@correo.com" autocomplete="username" required />
            </div>
          </div>

          <div class="field">
            <label for="loginPassword">Contraseña</label>
            <div class="input-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <input type="password" id="loginPassword" placeholder="••••••••" autocomplete="current-password" required />
              <button type="button" class="toggle-pass" id="togglePass" aria-label="Mostrar contraseña">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
          </div>

          <div class="login-error" id="loginError" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span id="loginErrorMsg">Credenciales incorrectas. Inténtalo de nuevo.</span>
          </div>

          <button type="submit" class="btn btn-primary btn-lg btn-block" id="loginSubmit">
            <span id="loginSubmitText">Iniciar sesión</span>
            <svg id="loginSubmitIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </form>

        <div class="login-foot">
          <a href={base}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Volver al sitio
          </a>
          <span>·</span>
          <span>Acceso restringido</span>
        </div>
      </div>
    </section>

    <script>
      import { supabaseBrowser, signInBrowser } from '../../lib/admin-auth';

      const form = document.getElementById('loginForm') as HTMLFormElement;
      const errorEl = document.getElementById('loginError') as HTMLElement;
      const errorMsg = document.getElementById('loginErrorMsg') as HTMLElement;
      const toggleBtn = document.getElementById('togglePass') as HTMLButtonElement;
      const passInput = document.getElementById('loginPassword') as HTMLInputElement;
      const emailInput = document.getElementById('loginEmail') as HTMLInputElement;
      const submitBtn = document.getElementById('loginSubmit') as HTMLButtonElement;
      const submitText = document.getElementById('loginSubmitText') as HTMLElement;
      const submitIcon = document.getElementById('loginSubmitIcon') as HTMLElement;

      // Si ya hay sesión, salta al panel.
      const baseHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
      supabaseBrowser.auth.getSession().then(({ data }) => {
        if (data.session) window.location.replace(`${baseHref}admin`);
      });

      toggleBtn?.addEventListener('click', () => {
        const showing = passInput.type === 'text';
        passInput.type = showing ? 'password' : 'text';
        toggleBtn.style.color = showing ? '' : 'var(--primary)';
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.hidden = true;

        submitBtn.disabled = true;
        submitText.textContent = 'Ingresando…';
        submitIcon.style.display = 'none';

        const { ok, error } = await signInBrowser(emailInput.value, passInput.value);

        if (ok) {
          window.location.href = `${baseHref}admin`;
          return;
        }

        // Error visible
        errorMsg.textContent = error || 'Credenciales incorrectas. Inténtalo de nuevo.';
        errorEl.hidden = false;
        // Re-disparar shake animation
        form.style.animation = 'none';
        void form.offsetWidth;
        form.style.animation = '';

        submitBtn.disabled = false;
        submitText.textContent = 'Iniciar sesión';
        submitIcon.style.display = '';
      });
    </script>
  </body>
</html>